# Copy to .env for local overrides. Flask's CLI loads .flaskenv; the app reads the
# variables below from the process environment.

# Port used by `flask run` (also in .flaskenv).
FLASK_RUN_PORT=3000

# SQLAlchemy database URL. Defaults to an absolute sqlite path under data/.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gym_membership

# Base URL of gym-payments-service-python, used when merging member accounts.
# Defaults to http://localhost:3001 when unset.
PAYMENTS_SERVICE_URL=http://localhost:3001
